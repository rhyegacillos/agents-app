# AWS Configuration
AWS_ACCOUNT_ID=your_12_digit_account_id
DEFAULT_AWS_REGION=ap-southeast-1
APP_RUNTIME_SECRETS_ARN=

# Project Configuration
PROJECT_NAME=digital-assistant

# Provider routing
# Bedrock is the default provider in this deployment shape.
# Switch back to Grok by changing AI_PROVIDER and supplying valid Grok credentials.
AI_PROVIDER=bedrock
BEDROCK_MODEL_ID=arn:aws:bedrock:ap-southeast-1:123456789012:inference-profile/apac.amazon.nova-lite-v1:0

# Optional Grok configuration
# Keep these empty for Bedrock-only deployments.
GROK_API_KEY=
GROK_API_URL=https://api.x.ai/v1
GROK_MODEL_ID=grok-4-1-fast

# Async execution
ASYNC_CHAT_ENABLED=true
ASYNC_WORKER_FUNCTION_NAME=digital-assistant-dev-worker
ASYNC_JOB_TTL_SECONDS=900
WORKER_MAX_SECONDS=240

# Model/runtime timeouts
LLM_TIMEOUT_SECONDS=120
RUNNER_TIMEOUT_SECONDS=180
MCP_STARTUP_TIMEOUT_SECONDS=25

# Tool providers
BRAVE_API_KEY=
RESEND_API_KEY=
RESEND_FROM=no-reply@example.com

# Storage
USE_S3=true
S3_BUCKET=
DOWNLOADS_BUCKET=
UPLOADS_BUCKET=

# Uploads and downloads
UPLOAD_PRESIGN_EXPIRES_SECONDS=900
PDF_URL_EXPIRES_SECONDS=86400
PDF_MAX_MB=50
PDF_MAX_CHARS=200000

# Daily quota
DAILY_TOKEN_LIMIT=100000
DAILY_PDF_LIMIT=10
DAILY_EMAIL_LIMIT=10
QUOTA_LOCAL_FALLBACK=true
QUOTA_LOCAL_DIR=/tmp/quota
S3_QUOTA_MAX_RETRIES=6

# Redis / async job state
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Logging
LOG_JSON=true
APP_TIMEZONE=Asia/Manila

# OpenTelemetry
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=digital-assistant-dev-api
OTEL_ENVIRONMENT=dev
OTEL_TRACES_SAMPLE_RATE=1.0
OTEL_LOGS_ENABLED=true
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_HEADERS=
OTEL_LOGS_MIN_LEVEL=INFO

# Trace hygiene
# Exclude high-volume polling endpoints so /quota and job polling do not bury worker/tool traces.
OTEL_FASTAPI_EXCLUDED_URLS=^/quota$,^/jobs(?:/.*)?$,^/memory(?:/.*)?$
