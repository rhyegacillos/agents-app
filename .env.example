# Core model keys
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GROK_API_KEY=

# Optional providers
BRAVE_API_KEY=
BRAVE_PRICE_TIMEOUT_SECONDS=8
POLYGON_API_KEY=
POLYGON_PLAN=free

# Runtime behavior
RUN_EVERY_N_MINUTES=60
RUN_EVEN_WHEN_MARKET_IS_CLOSED=false
USE_MANY_MODELS=false
READ_ONLY_MODE=false
AUTO_TRADE_BY_MARKET=false
MARKET_WATCH_INTERVAL_SEC=60
STRICT_FLAT_WHEN_NO_TRADE=true

# Optional api-local runtime paths
# TRADER_ENGINE_DIR=/app/api/trader_engine
# TRADER_DATA_DIR=/app/api/data

# Optional MCP toggles
ENABLE_BRAVE_MCP=true
ENABLE_MEMORY_MCP=true
ENABLE_FETCH_MCP=true
